// Map style URL. Empty value -> bundled placeholder style (Jol/Resources/placeholder-style.json).
// Note: in xcconfig "//" starts a comment, so write URLs with the slashes split via $() :
//   JOL_MAP_STYLE_URL = https:/$()/example.com/style.json
JOL_MAP_STYLE_URL =
JOL_MAP_STYLE_URL[sdk=iphonesimulator*] = http:/$()/localhost:8080/native/jol-light.json
JOL_API_BASE_URL =
JOL_API_BASE_URL[sdk=iphonesimulator*] = http:/$()/localhost:8000

// Sign in with Apple button on the sign-in screen. NO until the build is signed with the Sign in with Apple
// capability (paid Apple Developer Program, Ш-26); the button is then shown disabled with an explanation.
JOL_APPLE_SIGN_IN_ENABLED = NO

// Privacy policy page opened from "About" (Ш-52). PLACEHOLDER host: replace with the real one before release
// (docs/legal/privacy-policy.md is the draft text to publish there).
JOL_PRIVACY_URL = https:/$()/jol.kz/privacy
