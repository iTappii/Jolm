      "paint": { "fill-color": "#e6e0d4", "fill-outline-color": "#9a9a9a" } },
    { "id": "countries-boundary", "type": "line", "source": "demotiles", "source-layer": "countries",
      "paint": { "line-color": "#FF7A00", "line-width": 1 } }
  ]
