# --- Postgres (docker-compose) ---
POSTGRES_USER=jol
POSTGRES_PASSWORD=jol_dev_password
POSTGRES_DB=jol
POSTGRES_PORT=5433

# --- Server ---
DATABASE_URL=postgresql://jol:jol_dev_password@localhost:5433/jol
TEST_DATABASE_URL=postgresql://jol:jol_dev_password@localhost:5433/jol_test
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
MIN_IOS_VERSION=1.0.0
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Worker ---
WORKER_BATCH_SIZE=5
WORKER_POLL_INTERVAL_SEC=2
WORKER_MAX_ATTEMPTS=5

# --- External providers (empty in dev; real values go in .env, never committed) ---
LLM_PROVIDER=stub
LLM_API_KEY=
SMS_PROVIDER=stub
SMS_API_KEY=
EMAIL_PROVIDER=stub
EMAIL_API_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
VALHALLA_URL=http://127.0.0.1:8002
# VALHALLA_PORT=8002  (docker host port)
# VALHALLA_THREADS=4  (tile build / server threads)
OPEN_METEO_URL=https://api.open-meteo.com

# --- Admin panel (Ш-10) ---
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_MIN=15
