# --- Postgres (docker-compose) ---
POSTGRES_USER=jol
POSTGRES_PASSWORD=jol_dev_password
POSTGRES_DB=jol
POSTGRES_PORT=5433

# --- Server ---
DATABASE_URL=postgresql://jol:jol_dev_password@localhost:5433/jol
TEST_DATABASE_URL=postgresql://jol:jol_dev_password@localhost:5433/jol_test
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
MIN_IOS_VERSION=1.0.0
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Worker ---
WORKER_BATCH_SIZE=5
WORKER_POLL_INTERVAL_SEC=2
WORKER_MAX_ATTEMPTS=5

# --- External providers (empty in dev; real values go in .env, never committed) ---
LLM_PROVIDER=fake
LLM_API_KEY=
# LLM_PROVIDER=deepseek uses the three below (Ш-53); the key stays empty here, set it in .env only
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model limits (Ш-66): output cap per reply; daily token budgets (input+output, per day of the
# default region; 0 = no limit): registered user, guest per install id / per IP, whole service.
LLM_MAX_OUTPUT_TOKENS=800
LLM_MAX_OUTPUT_TOKENS_PLAN=1800
LLM_DAILY_TOKENS_USER=300000
LLM_DAILY_TOKENS_GUEST_INSTALL=60000
LLM_DAILY_TOKENS_GUEST_IP=300000
LLM_DAILY_TOKENS_GLOBAL=5000000
LLM_BUDGET_WARN_PERCENT=80
SMS_PROVIDER=stub
SMS_API_KEY=
EMAIL_PROVIDER=stub
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
VALHALLA_URL=http://127.0.0.1:8002
# VALHALLA_PORT=8002  (docker host port)
# VALHALLA_THREADS=4  (tile build / server threads)
OPEN_METEO_URL=https://api.open-meteo.com

# --- Email OTP (EMAIL_PROVIDER=smtp) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Admin panel (Ш-10) ---
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_MIN=15

# User authentication. Generate locally with python3.12 -c 'import secrets; print(secrets.token_urlsafe(48))'.
# AUTH_SECRET is the dev/test fallback for the four purpose secrets below. In any other APP_ENV
# (staging, prod) the API and the worker refuse to start unless all four are set (Ш-51).
AUTH_SECRET=
# `make secrets-generate` prints these four. Each >= 32 bytes and different from the others.
JWT_SECRET=
OTP_SECRET=
APPLE_CHALLENGE_SECRET=
# Fernet keys, comma separated: the first encrypts, all decrypt (rotation).
TOKEN_ENCRYPTION_KEYS=
# Only while Apple tokens encrypted before Ш-51 exist: the OLD AUTH_SECRET (decrypt-only).
# LEGACY_TOKEN_SECRET=

# --- Behind a reverse proxy / production (Ш-51) ---
# Proxies whose X-Forwarded-For is believed: IPs / CIDRs, comma separated. Empty = nobody.
# Behind a proxy it MUST be set, or every client shares the proxy's IP in the per-IP limits.
TRUSTED_PROXIES=
# GET /metrics (Prometheus text): needs this bearer token; without it, open in dev/test, 404 elsewhere
METRICS_TOKEN=
# Optional Sentry-compatible error reporting (pip install -e "server[sentry]"); empty = off
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Sign in with Apple server credentials (CREDENTIAL GAP: not provisioned yet) ---
# Needed to exchange the authorization code and to revoke the Apple grant on account deletion.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Weather (Ш-39). Free Open-Meteo API is non-commercial only; production needs the paid plan key.
OPEN_METEO_API_KEY=

# Push (Ш-40). "log" sends nothing. "apns" needs a paid Apple Developer account: team id, an APNs
# key id and the .p8 key contents (CREDENTIAL GAP, not provisioned). Sandbox host for dev builds.
PUSH_PROVIDER=log
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=
APNS_SANDBOX=true
# Worker: seconds a claimed job may run before another worker takes it over
WORKER_LEASE_SEC=300

# --- User photo storage (Ш-44) ---
# STORAGE_PROVIDER: empty = no storage (uploads answer 503), "local" = files on disk served by the
# API under /media (dev/test only, no Docker needed), "s3" = any S3-compatible service
# (path-style, SigV4 presigned PUT). The s3 adapter was run against an S3 emulator only (Ш-55), not a real bucket.
STORAGE_PROVIDER=local
# Public base of stored photos: <MEDIA_BASE_URL>/<storage_key>. For "local": the API's /media.
MEDIA_BASE_URL=http://127.0.0.1:8000/media
STORAGE_LOCAL_DIR=
STORAGE_LOCAL_UPLOAD_BASE=http://127.0.0.1:8000
# Local MinIO (docs/photos.md): `make minio-up`, then uncomment these and set STORAGE_PROVIDER=s3 and
# MEDIA_BASE_URL=http://127.0.0.1:9000/jol-media. The admin (/admin) then uploads place photos there.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=jol-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY=jol_minio
# S3_SECRET_KEY=jol_minio_dev_password

# --- Analytics (Ш-50) ---
# POST /v1/analytics/events: batches per hour per X-Install-ID and per client IP (counted in
# PostgreSQL, shared by all API processes since Ш-51).
# ANALYTICS_INSTALL_LIMIT=120
# ANALYTICS_IP_LIMIT=600
# ANALYTICS_WINDOW_SEC=3600
