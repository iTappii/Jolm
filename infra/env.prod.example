# Template for .env.prod / .env.staging (never commit the real file). Docs: docs/deploy.md
# Comments stay on their own lines: Docker Compose would read a trailing "# ..." after an empty
# value as the value.
# prod or staging (anything but dev/test turns on the strict secret checks)
APP_ENV=prod

POSTGRES_USER=jol
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=jol
DATABASE_URL=postgresql://jol:CHANGE_ME@postgres:5432/jol

# `make secrets-generate` prints the next four lines: paste them here
JWT_SECRET=
OTP_SECRET=
APPLE_CHALLENGE_SECRET=
TOKEN_ENCRYPTION_KEYS=

# The reverse proxy / load balancer address(es) or CIDR, comma separated
TRUSTED_PROXIES=
# Bearer token for GET /metrics
METRICS_TOKEN=
# Optional Sentry-compatible DSN (build the image with EXTRAS="[sentry]")
SENTRY_DSN=

VALHALLA_URL=http://valhalla:8002
# Host path of the Kazakhstan OSM extract that Valhalla builds its tiles from
OSM_PBF=/srv/jol/kazakhstan.osm.pbf

STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MEDIA_BASE_URL=

OPEN_METEO_API_KEY=
LLM_PROVIDER=
EMAIL_PROVIDER=smtp
SMS_PROVIDER=
PUSH_PROVIDER=apns
APNS_SANDBOX=false
